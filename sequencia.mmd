sequenceDiagram
    autonumber
    actor Estudante
    participant Frontend as Front-end React
    participant Match as MatchService
    participant Vagas as VagaService
    participant Contrato as ContratoService
    participant DB as PostgreSQL
    participant Assinatura as ServicoAssinatura

    Estudante->>Frontend: solicitarMatch()
    Frontend->>Match: calcularCompatibilidade(CompetenciasDTO)
    Match->>DB: buscarCompetenciasEstudante()
    DB-->>Match: CompetenciasEstudanteDTO
    Match->>Vagas: listarVagasAtivas()
    Vagas->>DB: consultarVagas()
    DB-->>Vagas: ListaVagasDTO
    Vagas-->>Match: ListaVagasDTO
    Match->>Match: calcularPontuacao()

    alt Existem vagas compativeis
        Match-->>Frontend: ResultadoMatchDTO
        Frontend-->>Estudante: exibirVagasCompativeis()
        Estudante->>Frontend: selecionarVaga()
        Frontend->>Contrato: criarContrato(ContratoDTO)
        Contrato->>DB: salvarContrato()
        DB-->>Contrato: ContratoDTO
        Contrato->>Assinatura: solicitarAssinatura(ContratoDTO)
        Assinatura-->>Contrato: SolicitacaoAssinaturaDTO
        Contrato->>DB: atualizarStatusEmAssinatura()
        Contrato-->>Frontend: ContratoPendenteDTO
        Frontend-->>Estudante: exibirContratoParaAssinatura()
    else Nenhuma vaga compativel
        Match-->>Frontend: MatchNaoEncontradoDTO
        Frontend-->>Estudante: informarAusenciaDeVagas()
    end

    Assinatura-)Contrato: webhookAssinaturaAtualizada(EventoAssinaturaDTO)
    Contrato->>DB: atualizarStatusContrato()
